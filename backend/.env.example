# Copy this file to ".env" and fill in your own values.
# URL shape: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/kaisei_client_desk"
PORT=5000
# Where the React dev server runs (needed for CORS)
CORS_ORIGIN="http://localhost:5173"
# true = print the SQL Prisma generates in the backend terminal
LOG_QUERIES=false
