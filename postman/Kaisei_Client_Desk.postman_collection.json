        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Copy\",\n  \"email\": \"ravi@kadambabooks.in\"\n}"
        }
      }
    },
    {
      "name": "2c. Create client - invalid email (400)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/clients",
          "host": [
            "{{baseUrl}}"
