{
  "info": {
    "name": "Kaisei Client Desk API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Try the whole API in order. Set the collection variable baseUrl to http://localhost:5000/api"
  },
  "item": [
    {
      "name": "0. Health check (API + database)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "1. Dashboard stats",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/stats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "stats"
          ]
        }
      }
    },
    {
      "name": "2. Create client",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/clients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clients"
          ]
        },
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ravi Menon\",\n  \"company\": \"Kadamba Books\",\n  \"email\": \"ravi@kadambabooks.in\",\n  \"phone\": \"+91 90000 11111\"\n}"
        }
      }
    },
    {
      "name": "2b. Create client - duplicate email (409)",
